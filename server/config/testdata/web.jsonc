// 带注释的 JSON
{
    "http": {
        "port": ":8082",
        "headers": [
            {
                "key": "H1",
                "val": "v1"
            },
            {
                "key": "h2",
                "val": "v2"
            }
        ]

    },
    "timezone": "Africa/Addis_Ababa",
    "mimetypes": [
        {
            "type": "application/json",
            "target": "json"
        },
        {
            "type": "text/xml",
            "target": "xml"
        },
        {
            "type": "multipart/form-data",
            "target": "nop"
        }
    ]
}
